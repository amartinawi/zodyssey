# ZOdyssey run artifacts — these are personal/local, never commit them.
# They are created at runtime under <repo>/.zcode/ during /orchestrate runs.
.zcode/state/
.zcode/plans/
.zcode/notepads/
.zcode/memory/
.zcode/teams/
.zcode/reviews/
.zcode/staging/
.zcode/toolchain.json
.zcode/capabilities.lock.json

# The cross-run eval ledger (optional, local-only). Seeds ship in the repo.
.zcode/orchestration/eval/results.jsonl
.zcode/orchestration/eval/judged.jsonl
.zcode/orchestration/eval/runs/
.zcode/orchestration/memory.json

# Node
node_modules/
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Final-wave verify artifacts (run-state, never commit)
.zcode/verify/

# Machine-specific capabilities lock (regenerate locally with resolve-capabilities.mjs)
/capabilities.lock.json

# Local audit prompts + verdicts (personal, and verdict files may hold model output)
.zcode/audits/

# ORCH-3: same reasoning as .zcode/audits/ — audit REPORTS are run output, not source, and they
# quote model text. This directory was unignored, so every future report would land untracked-but-
# visible and eventually get committed by an `git add -A`. The v0.4.1 report is kept deliberately
# as the release's provenance (v0.5.0 is the remediation of it), so it stays tracked by name.
.zcode/reports/
!.zcode/reports/v0-4-1-full-audit-findings.md

# Third-party agent tooling that writes into the working tree
.claude-flow/
.swarm/
ruvector.db

# External-audit working artifacts for stateless work (manual consult rounds; plan + task + prompt
# driver + verdict JSON quote model output). Same ORCH-3 reasoning as .zcode/audits/ and
# .zcode/reports/: run output, not source.
.zcode/isnad-adaptation-audit/
