{
  "name": "zodyssey",
  "displayName": "ZOdyssey",
  "version": "0.6.17",
  "description": "A hybrid-enforced multi-agent orchestration pipeline for ZCode: prime, triage, consult, plan, review (gated), execute, verify, final-wave. Code-enforces the invariants omo leaves to convention.",
  "author": {
    "name": "amartinawi",
    "url": "https://github.com/amartinawi"
  },
  "homepage": "https://github.com/amartinawi/zodyssey",
  "repository": "https://github.com/amartinawi/zodyssey",
  "license": "MIT",
  "keywords": [
    "orchestration",
    "multi-agent",
    "planning",
    "code-review",
    "enforcement",
    "hooks",
    "zcode",
    "pipeline"
  ],
  "skills": "./skills/",
  "agents": "./agents/",
  "commands": "./commands/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|ApplyPatch|MultiEdit|NotebookEdit|Bash|Task|Agent|dispatch_agent|Skill|mcp__.*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/odyssey/hooks/pre-tool.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Agent|dispatch_agent|Edit|Write|MultiEdit|Skill|mcp__.*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/odyssey/hooks/post-tool.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/odyssey/hooks/stop.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/odyssey/hooks/user-prompt-submit.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
